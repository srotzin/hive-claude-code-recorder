{
 "kind": "hive.approved-calculation/1",
 "name": "Par-weighted average spread to benchmark",
 "formula": "R = round half up of sum(w_i * (y_i - b_i)) / sum(w_i), with y and b in thousandths of a percent (tenths of a basis point) and w the par held",
 "n": 8,
 "output": {
  "signal": 3,
  "unit": "bp",
  "scale": 10,
  "decimals": 1
 },
 "public_signals": [
  "Cy",
  "Cb",
  "Cw",
  "R"
 ],
 "commitment_scheme": "hive.poseidon-commit/1",
 "inputs": {
  "Cy": {
   "from": "vendor delivery",
   "vendor": "market-data",
   "tool": "get_bond_evaluations",
   "dataset": "bonds.evaluated-pricing",
   "rows": "rows",
   "id": "cusip",
   "value": "yield_pct",
   "scale": 1000
  },
  "Cb": {
   "from": "vendor delivery",
   "vendor": "market-data",
   "tool": "get_benchmark_yields",
   "dataset": "bonds.benchmark-yields",
   "rows": "rows",
   "id": "cusip",
   "value": "benchmark_yield_pct",
   "scale": 1000
  },
  "Cw": {
   "from": "firm commitment",
   "kind": "hive.portfolio-commitment/1",
   "value": "par_thousands",
   "logged": "before the first delivery used"
  }
 },
 "proof_system": "PLONK over BN254 (snarkjs 0.7.5); circuit compiled with circom 2.2.2 and circomlib 2.0.5",
